<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="using:Uwielbienia.Core.Presentation"
             xmlns:v="using:Uwielbienia.App.Views"
             xmlns:vm="using:Uwielbienia.App.ViewModels"
             x:Class="Uwielbienia.App.Views.SlideView"
             x:Name="Root">
  <UserControl.Resources>
    <!-- Napis kiosku (tytuł nad tekstem); wielkość liter z FontSize miejsca, w którym stoi. -->
    <DataTemplate x:Key="KioskCaption" x:DataType="vm:KioskFramePage">
      <StackPanel HorizontalAlignment="Center">
        <StackPanel IsVisible="{Binding HasTitle}" HorizontalAlignment="Center">
          <TextBlock Text="{Binding Title}" TextAlignment="Center" TextWrapping="Wrap"
                     FontFamily="{StaticResource TitleFont}" Foreground="{Binding #Root.SlideTitle}" />
          <Border Height="4" CornerRadius="2" Margin="0,14,0,0" Background="{Binding #Root.SlideAccent}" />
        </StackPanel>
        <TextBlock Text="{Binding Text}" IsVisible="{Binding HasBody}" TextAlignment="Center" TextWrapping="Wrap"
                   FontFamily="{StaticResource TitleFont}" Foreground="{Binding #Root.SlideForeground}"
                   Margin="{Binding HasTitle, Converter={x:Static v:SlideConverters.PartGap}, ConverterParameter=36}" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <!-- Slajd renderowany na wirtualnym płótnie 1920×1080 i skalowany w całości, więc wygląda
       tak samo na każdym rzutniku. Tekst: Literata (szeryfowa, do czytania na ekranie, pełne
       polskie znaki) — spokojniejsza z daleka niż krój interfejsu. -->
  <Viewbox Stretch="Uniform">
    <Border Width="1920" Height="1080" Background="{Binding #Root.SlideBackground}">
      <TransitioningContentControl Content="{Binding #Root.Page}">
        <TransitioningContentControl.PageTransition>
          <CrossFade Duration="0:0:0.15" />
        </TransitioningContentControl.PageTransition>
        <!-- Strona wybierana wg rodzaju: slajd prezentacji (obraz na cały ekran) i film przed stroną z tekstem. -->
        <TransitioningContentControl.DataTemplates>
          <DataTemplate DataType="vm:ProjectedVideo">
            <v:VideoSurface Frames="{Binding Frames}" />
          </DataTemplate>
          <!-- Obraz na tle ekranu (czarnym albo jasnym — „Ekran: …”), jak tekst. -->
          <DataTemplate DataType="vm:ProjectedImage">
            <Panel Background="{Binding #Root.SlideBackground}">
              <Image Source="{Binding Picture^}" Stretch="Uniform" />
            </Panel>
          </DataTemplate>
          <!-- Kiosk: elementy zmieniają się same, z efektem przejścia wybranym w kiosku (cała strona zostaje ta sama).
               Zdjęcia powoli się przybliżają (SlowZoom) — w ramce, która przycina obraz do jego miejsca. -->
          <DataTemplate DataType="vm:ProjectedKiosk">
            <TransitioningContentControl Content="{Binding Playback.Frame}" PageTransition="{Binding Playback.Transition}">
              <TransitioningContentControl.DataTemplates>
                <DataTemplate DataType="vm:KioskFramePage">
                  <!-- Napis jak tekst pieśni: Literata, tytuł w kolorze tytułu z linią; obok obrazu i pod nim mniejszy. -->
                  <Panel Background="{Binding #Root.SlideBackground}">
                    <!-- Zoom tylko w obrębie zdjęcia (ramka na jego wymiar): przesuwany element nie sięga brzegów ekranu,
                         gdzie jego krawędź rysowała się cienką jasną linią. -->
                    <Panel IsVisible="{Binding IsImageOnly}">
                      <Border ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="{Binding Picture}" Stretch="Uniform" v:SlowZoom.Duration="{Binding ZoomDuration}" />
                      </Border>
                    </Panel>
                    <Viewbox IsVisible="{Binding IsTextOnly}" StretchDirection="DownOnly" Margin="140,40" VerticalAlignment="Center">
                      <ContentControl Width="1640" FontSize="86" Content="{Binding}" ContentTemplate="{StaticResource KioskCaption}" />
                    </Viewbox>
                    <!-- obraz pionowy (do ok. 3:2): napis z prawej -->
                    <Grid IsVisible="{Binding IsTextRight}" ColumnDefinitions="*,640" Margin="40">
                      <Border ClipToBounds="True" Margin="0,0,48,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Image Source="{Binding Picture}" Stretch="Uniform" v:SlowZoom.Duration="{Binding ZoomDuration}" />
                      </Border>
                      <Viewbox Grid.Column="1" StretchDirection="DownOnly" VerticalAlignment="Center">
                        <ContentControl Width="600" FontSize="60" Content="{Binding}" ContentTemplate="{StaticResource KioskCaption}" />
                      </Viewbox>
                    </Grid>
                    <!-- obraz poziomy: napis pod spodem -->
                    <Grid IsVisible="{Binding IsTextBelow}" RowDefinitions="*,300" Margin="40,40,40,30">
                      <Border ClipToBounds="True" Margin="0,0,0,24" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="{Binding Picture}" Stretch="Uniform" v:SlowZoom.Duration="{Binding ZoomDuration}" />
                      </Border>
                      <Viewbox Grid.Row="1" StretchDirection="DownOnly" VerticalAlignment="Center">
                        <ContentControl Width="1640" FontSize="60" Content="{Binding}" ContentTemplate="{StaticResource KioskCaption}" />
                      </Viewbox>
                    </Grid>
                  </Panel>
                </DataTemplate>
              </TransitioningContentControl.DataTemplates>
            </TransitioningContentControl>
          </DataTemplate>
          <DataTemplate DataType="vm:ProjectedPage">
            <Panel>
              <!-- Małe marginesy u góry i u dołu: obraz dopasowuje się do ekranu w sali narożnikami („Dopasuj obraz”). -->
              <Viewbox StretchDirection="DownOnly" Margin="140,40" VerticalAlignment="Center">
                <StackPanel Width="1640">
                  <!-- Początek pieśni: tytuł tej samej wielkości co tekst, oddzielony linią w kolorze świecy. -->
                  <StackPanel IsVisible="{Binding HasTitle}" HorizontalAlignment="Center" Margin="0,0,0,40">
                    <TextBlock Text="{Binding Title}" TextAlignment="Center" TextWrapping="Wrap"
                               FontFamily="{StaticResource TitleFont}" FontSize="86"
                               Foreground="{Binding #Root.SlideTitle}" />
                    <Border Height="4" CornerRadius="2" Margin="0,14,0,0" Background="{Binding #Root.SlideAccent}" />
                  </StackPanel>
                  <!-- Treść slajdu: szablon wybierany wg rodzaju slajdu. Nowy rodzaj (rekord dziedziczący
                       po Slide) = nowy DataTemplate PRZED szablonem tekstu, bo ten pasuje do każdego Slide. -->
                  <ContentControl Content="{Binding Slide}">
                    <ContentControl.DataTemplates>
                      <DataTemplate DataType="p:Slide">
                        <ItemsControl ItemsSource="{Binding Lines}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="p:SlideLine">
                              <!-- Słowa powtarzające tytuł pieśni (zamiast tytułu nad tekstem) — w kolorze tytułu, reszta wersu zwykła.
                                   Refren dołączony do zwrotki: odstęp nad nim i kursywa. -->
                              <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontFamily="{StaticResource TitleFont}"
                                         FontSize="86" Padding="0,4" Foreground="{Binding #Root.SlideForeground}"
                                         Margin="{Binding StartsPart, Converter={x:Static v:SlideConverters.PartGap}, ConverterParameter=40}"
                                         FontStyle="{Binding IsChorus, Converter={x:Static v:SlideConverters.ChorusStyle}}">
                                <Run Text="{Binding TitlePart}" Foreground="{Binding #Root.SlideTitle}" /><Run Text="{Binding Rest}" /><Run Text="{Binding Repeat, Converter={x:Static v:SlideConverters.RepeatSuffix}}"
                                     FontSize="54" Foreground="{Binding #Root.SlideMuted}" />
                              </TextBlock>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </DataTemplate>
                    </ContentControl.DataTemplates>
                  </ContentControl>
                </StackPanel>
              </Viewbox>
            </Panel>
          </DataTemplate>
        </TransitioningContentControl.DataTemplates>
      </TransitioningContentControl>
    </Border>
  </Viewbox>
</UserControl>
