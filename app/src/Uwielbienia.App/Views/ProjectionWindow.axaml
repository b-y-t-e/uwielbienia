<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Uwielbienia.App.ViewModels"
        xmlns:v="using:Uwielbienia.App.Views"
        x:Class="Uwielbienia.App.Views.ProjectionWindow"
        x:DataType="vm:ProjectionViewModel"
        Title="Uwielbienia — ekran"
        Icon="avares://Uwielbienia.App/Assets/icon.ico"
        Background="{Binding Live.Appearance.Background}"
        WindowStartupLocation="Manual"
        WindowDecorations="None"
        Topmost="True"
        ShowInTaskbar="False">
  <Panel x:Name="Screen">
    <!-- Obraz projekcji rozpięty na narożnikach z „Dopasuj obraz” (przekształcenie ustawia kod). Własne tło w kolorze
         ekranu: brzegi slajdu wygładzane przy przekształceniu łączą się z nim w tej samej warstwie, bez jasnej linii. -->
    <Panel x:Name="Warped" RenderTransformOrigin="0,0" Background="{Binding Live.Appearance.Background}">
      <v:SlideView x:Name="Slide"
                   Page="{Binding Live.Page}"
                   SlideBackground="{Binding Live.Appearance.Background}"
                   SlideForeground="{Binding Live.Appearance.Foreground}"
                   SlideMuted="{Binding Live.Appearance.Muted}"
                   SlideAccent="{Binding Live.Appearance.Accent}"
                   SlideTitle="{Binding Live.Appearance.Title}" />
      <v:CalibrationGrid IsVisible="{Binding Calibration.IsGridVisible}" />
      <!-- Postęp filmu (przewijanie): tylko razem z uchwytami dopasowania obrazu — po ruchu myszą albo w trybie K,
           więc sala go zwykle nie widzi. W obrębie dopasowanego obrazu (widać go na ekranie w sali). -->
      <!-- Pilot przy filmie: po długim „do tyłu” — co zrobi drugie długie naciśnięcie (kilka sekund). -->
      <Border IsVisible="{Binding Live.Video.IsPromptVisible}" VerticalAlignment="Top" HorizontalAlignment="Center"
              Margin="0,40,0,0" Padding="22,12" CornerRadius="12" Background="#D9201A14">
        <StackPanel Spacing="4">
          <TextBlock Text="Przytrzymaj „do tyłu” — poprzednia pozycja planu" FontSize="24" Foreground="#F4ECDD" />
          <TextBlock Text="Przytrzymaj „do przodu” — następna pozycja planu" FontSize="24" Foreground="#F4ECDD" />
        </StackPanel>
      </Border>
      <Border x:Name="VideoBar" IsVisible="False" VerticalAlignment="Bottom" Margin="60,0,60,40" Padding="18,8"
              CornerRadius="12" Background="#B3201A14">
        <Grid ColumnDefinitions="*,16,Auto,16,Auto">
          <Slider Minimum="0" Maximum="{Binding Live.Video.DurationSeconds}" Value="{Binding Live.Video.PositionSeconds}"
                  VerticalAlignment="Center" Focusable="False" />
          <TextBlock Grid.Column="2" Text="{Binding Live.Video.TimeText}" VerticalAlignment="Center" FontSize="18"
                     Foreground="#C9CCD8" FontFeatures="+tnum" />
          <!-- przesunięcie obrazu względem dźwięku — tylko gdy ustawione ([ / ]) -->
          <TextBlock Grid.Column="4" Text="{Binding Live.Video.PictureOffsetText, StringFormat='Obraz {0}'}"
                     IsVisible="{Binding Live.Video.HasPictureOffset}" VerticalAlignment="Center" FontSize="18"
                     Foreground="#C9CCD8" FontFeatures="+tnum" />
        </Grid>
      </Border>
    </Panel>
    <!-- Uchwyty dopasowania: po ruchu myszą (3 s) albo w trybie kalibracji — widoczność ustawia kod. -->
    <v:CalibrationHandles x:Name="Handles" IsVisible="False"
                          Corners="{Binding Calibration.Corners}" SelectedCorner="{Binding Calibration.SelectedCorner}" />

    <!-- Tryb jednego urządzenia: dyskretne sterowanie na dole (także dotykiem). -->
    <StackPanel x:Name="SameScreenBar" IsVisible="False" Orientation="Horizontal" Spacing="8"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" Opacity="0.35">
      <Button Content="Wstecz" Command="{Binding Live.PreviousCommand}" Focusable="False" />
      <Button Content="Szukaj pieśni" Click="OnSearchClick" Focusable="False" />
      <Button Content="Dalej" Command="{Binding Live.NextCommand}" Focusable="False" />
      <Button Content="Wróć do planu (Esc)" Click="OnExitClick" Focusable="False" />
    </StackPanel>

    <!-- Szybki wybór pieśni w trakcie śpiewu: tekst zostaje na ekranie, dopóki nie wybierzesz nowej. -->
    <Border IsVisible="{Binding IsQuickPickOpen}" Background="{DynamicResource ScrimBrush}" Cursor="Arrow">
      <Border Classes="panel" Width="720" MaxHeight="620" VerticalAlignment="Top" Margin="0,80,0,0">
        <DockPanel>
          <TextBox x:Name="QuickPickBox" DockPanel.Dock="Top" Classes="search"
                   Text="{Binding QuickPick.Query}" PlaceholderText="Numer albo słowa pieśni" />
          <ListBox ItemsSource="{Binding QuickPick.Results}" SelectedItem="{Binding QuickPick.Selected}"
                   Margin="0,10,0,0" DoubleTapped="OnResultDoubleTapped">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SongResultViewModel">
                <Grid ColumnDefinitions="52,*">
                  <TextBlock Classes="number" Text="{Binding Number}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Classes="bodyStrong" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="caption" Text="{Binding FirstLine}" IsVisible="{Binding FirstLine, Converter={x:Static ObjectConverters.IsNotNull}}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Border>
  </Panel>
</Window>
