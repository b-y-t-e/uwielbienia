<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Uwielbienia.App.ViewModels"
             x:Class="Uwielbienia.App.Views.RemoteOverlay"
             x:DataType="vm:RemoteViewModel">
  <Border Background="{DynamicResource ScrimBrush}">
    <Border Classes="panel" Width="640" Padding="28" VerticalAlignment="Center">
      <StackPanel Spacing="14">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="songTitle" Text="Telefon lub drugi komputer" />
          <Button Grid.Column="1" Classes="quiet closeButton" Content="✕" ToolTip.Tip="Zamknij" Command="{Binding CloseCommand}" VerticalAlignment="Top" />
        </Grid>
        <TextBlock TextWrapping="Wrap" FontSize="15"
                   Text="Zeskanuj kod aparatem telefonu. Otworzy się pilot: tekst z akordami, Dalej i Wstecz. Na komputerze otwórz ten sam adres i wybierz „Ekran”, żeby pokazywać tekst w przeglądarce." />
        <Border Background="White" CornerRadius="12" Padding="8" HorizontalAlignment="Center" Width="300" Height="300">
          <Panel>
            <Image Source="{Binding QrCode}" Stretch="Uniform" />
            <TextBlock Text="Przygotowuję kod…" Foreground="#1B2138" HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding IsBusy}" />
          </Panel>
        </Border>
        <SelectableTextBlock Text="{Binding PageUrl}" TextWrapping="Wrap" FontSize="13" HorizontalAlignment="Center"
                             Foreground="{DynamicResource MutedBrush}" />
        <TextBlock Classes="caption" Text="{Binding ExpiresText}" HorizontalAlignment="Center" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
          <Button Grid.Column="1" Content="Nowy kod" Command="{Binding InviteCommand}" />
        </Grid>
        <!-- Domyślnie telefon tylko zmienia slajdy (można dać dziecku); dodawanie pieśni operator włącza osobno. -->
        <StackPanel Spacing="4" IsVisible="{Binding HasPairedDevices}">
          <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,2,0,6" />
          <ItemsControl ItemsSource="{Binding Devices}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RemoteDeviceViewModel">
                <Grid ColumnDefinitions="Auto,10,*,Auto,8,Auto" Margin="0,4">
                  <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                           Fill="{DynamicResource MutedBrush}" IsVisible="{Binding !IsConnected}" />
                  <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                           Fill="{DynamicResource TextBrush}" IsVisible="{Binding IsConnected}" />
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Classes="caption" Text="{Binding Details}" />
                  </StackPanel>
                  <CheckBox Grid.Column="3" Content="Dodaje pieśni" IsChecked="{Binding CanAddSongs}" VerticalAlignment="Center"
                            ToolTip.Tip="Telefon może dodać pieśń z wyszukiwarki jako następną w planie" />
                  <Panel Grid.Column="5" VerticalAlignment="Center">
                    <Button Classes="quiet removeItem" Content="Zapomnij" Command="{Binding ForgetCommand}"
                            IsVisible="{Binding !IsConfirmingForget}" ToolTip.Tip="Rozparuj — połączy się znowu dopiero po nowym kodzie" />
                    <Button Classes="danger" Content="Zapomnieć?" Command="{Binding ForgetCommand}"
                            IsVisible="{Binding IsConfirmingForget}" />
                  </Panel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding DevicesError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                     IsVisible="{Binding DevicesError, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
        <TextBlock Classes="caption" TextWrapping="Wrap"
                   Text="Sparowane urządzenie łączy się samo przy każdym uruchomieniu. Połączenie jest szyfrowane i przechodzi przez publiczny serwer pośredniczący." />
      </StackPanel>
    </Border>
  </Border>
</UserControl>
