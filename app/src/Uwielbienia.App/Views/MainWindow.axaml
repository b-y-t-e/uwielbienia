<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Uwielbienia.App.ViewModels"
        xmlns:v="using:Uwielbienia.App.Views"
        xmlns:p="using:Uwielbienia.Core.Presentation"
        xmlns:primitives="using:Avalonia.Controls.Primitives"
        x:Class="Uwielbienia.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Uwielbienia"
        Width="1280" Height="800" MinWidth="860" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">
  <Panel>
    <DockPanel Margin="16">

      <!-- Pasek górny: plan, stan projekcji, telefon, wygląd -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="4,0,4,14">
        <Button Classes="quiet" Command="{Binding Plans.ShowCommand}" ToolTip.Tip="Plany: otwórz, utwórz, użyj ponownie">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Classes="songTitle" Text="{Binding Plan.Name}" />
            <TextBlock Classes="caption" Text="{Binding Plan.DateText}" VerticalAlignment="Center" IsVisible="{Binding Plan.DateText, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Classes="caption" Text="▾" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <!-- Aktualizacja w kolumnie *, żeby w wąskim oknie zwężała się zamiast wypychać pozostałe przyciski -->
        <DockPanel Grid.Column="1" Margin="8,0" HorizontalAlignment="Right" IsVisible="{Binding IsUpdateAvailable}">
          <Button DockPanel.Dock="Right" Classes="primary" Command="{Binding ApplyUpdateCommand}"
                  ToolTip.Tip="Pobrano nowszą wersję z GitHub — zainstaluj i uruchom ponownie">
            <TextBlock Text="{Binding UpdateVersion, StringFormat='Aktualizuj do {0}'}" TextTrimming="CharacterEllipsis" />
          </Button>
          <TextBlock Classes="caption" VerticalAlignment="Center" Margin="0,0,8,0" Text="{Binding UpdateError}"
                     MaxWidth="240" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding UpdateError}"
                     IsVisible="{Binding UpdateError, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </DockPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button Command="{Binding ToggleProjectionCommand}" ToolTip.Tip="F5">
            <TextBlock Text="{Binding ProjectionStatus}" />
          </Button>
          <Button Command="{Binding Remote.ShowCommand}" ToolTip.Tip="Sparuj telefon jako pilota albo przeglądarkę jako ekran">
            <TextBlock Text="{Binding Remote.BadgeText}" />
          </Button>
          <Button Command="{Binding ToggleThemeCommand}">
            <Panel>
              <TextBlock Text="Jasny wygląd" IsVisible="{Binding IsDarkTheme}" />
              <TextBlock Text="Ciemny wygląd" IsVisible="{Binding !IsDarkTheme}" />
            </Panel>
          </Button>
        </StackPanel>
      </Grid>

      <Grid x:Name="Columns">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="16*" MinWidth="160" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="42*" MinWidth="280" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="42*" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <!-- PLAN -->
        <Border Classes="panel" Padding="10,14">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Classes="heading" Text="Plan" Margin="8,0,0,10" />
            <TextBlock DockPanel.Dock="Top" Classes="caption" TextWrapping="Wrap" Margin="8,0"
                       IsVisible="{Binding Plan.IsEmpty}"
                       Text="Plan jest pusty. Wpisz numer lub tytuł pieśni i wybierz „Na koniec planu”." />
            <ListBox x:Name="PlanList" ItemsSource="{Binding Plan.Items}" SelectedItem="{Binding Plan.Selected}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PlanItemViewModel">
                  <Grid ColumnDefinitions="*,Auto" Classes.dragged="{Binding IsDragged}">
                    <Button Classes="quiet planItem" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Click="OnPlanItemClick" DoubleTapped="OnPlanItemDoubleTapped"
                            ToolTip.Tip="Kliknij, aby wybrać · dwuklik pokazuje · przeciągnij, aby zmienić kolejność">
                      <Grid ColumnDefinitions="4,32,*">
                        <Border Background="{DynamicResource CandleBrush}" CornerRadius="2" IsVisible="{Binding IsLive}" Margin="0,2" />
                        <TextBlock Grid.Column="1" Classes="number" Text="{Binding Number}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                          <TextBlock Classes="bodyStrong" Text="{Binding Title}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="caption" Text="{Binding Arrangement}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Grid>
                    </Button>
                    <Button Grid.Column="1" Classes="quiet removeItem" Content="✕" ToolTip.Tip="Usuń z planu" VerticalAlignment="Center"
                            Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).Plan.RequestRemoveCommand}" CommandParameter="{Binding}" />
                    <!-- Miejsce upuszczenia przy zmianie kolejności -->
                    <Border Grid.ColumnSpan="2" Classes="dropMarker" VerticalAlignment="Top" Margin="0,-6,0,0"
                            IsVisible="{Binding IsDropBefore}" />
                    <Border Grid.ColumnSpan="2" Classes="dropMarker" VerticalAlignment="Bottom" Margin="0,0,0,-6"
                            IsVisible="{Binding IsDropAfter}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Classes="paneDivider" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                      DragCompleted="OnColumnSplitterDragCompleted" ToolTip.Tip="Przeciągnij, aby zmienić szerokość paneli" />

        <!-- PIEŚŃ: wyszukiwarka + tekst wybranej pieśni; nic tu nie zmienia ekranu bez „Pokaż na ekranie”. -->
        <Grid Grid.Column="2" RowDefinitions="Auto,*" ColumnDefinitions="3*,*">
          <TextBox x:Name="SearchBox" Classes="search" Text="{Binding Search.Query}"
                   GotFocus="OnSearchFocus" TextChanged="OnSearchTextChanged"
                   PlaceholderText="Szukaj pieśni: numer albo słowa" />

          <!-- Pole tekstowe z dropdownem zamiast panelu zajmującego miejsce w głównym układzie. -->
          <primitives:Popup x:Name="SearchPopup" PlacementTarget="{Binding #SearchBox}"
                            Placement="BottomEdgeAlignedLeft" VerticalOffset="8"
                            IsLightDismissEnabled="True">
            <Border Classes="panel" Width="{Binding #SearchBox.Bounds.Width}" Padding="8" MaxHeight="360">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Classes="caption" Margin="8,2,0,6"
                           Text="Kliknij: wybierz · Enter: pokaż · Ctrl+Enter: jako następna · Esc: zamknij" />
                <ListBox ItemsSource="{Binding Search.Results}" SelectedItem="{Binding Search.Selected}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SongResultViewModel">
                      <Grid ColumnDefinitions="40,*" PointerReleased="OnSearchResultPointerReleased">
                        <TextBlock Classes="number" Text="{Binding Number}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Classes="bodyStrong" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="caption" Text="{Binding FirstLine}" TextTrimming="CharacterEllipsis"
                                     IsVisible="{Binding FirstLine, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </Border>
          </primitives:Popup>

          <Border Grid.Row="1" Grid.ColumnSpan="2" Classes="panel" Margin="0,10,0,0" Padding="18,16">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Classes="heading" Text="Pieśń" />
                <TextBlock Classes="caption" Text="Wybrana pieśń — nie zmienia tego, co widzi sala" />
              </StackPanel>
              <Panel>
                <TextBlock Classes="bodyMuted" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding !Preview.HasSong}" TextAlignment="Center"
                           Text="Wybierz pieśń z planu albo wpisz jej numer lub tytuł." />
                <DockPanel IsVisible="{Binding Preview.HasSong}">
                  <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*">
                    <TextBlock Classes="displayNumber" Text="{Binding Preview.Number}" Margin="0,2,14,0" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Classes="songTitle" Text="{Binding Preview.Title}" TextWrapping="Wrap" TextTrimming="None" />
                      <TextBlock Classes="caption" Text="{Binding Preview.Category}" />
                    </StackPanel>
                  </Grid>
                  <WrapPanel DockPanel.Dock="Top" Margin="0,14,0,0">
                    <Button Classes="primary" Content="Pokaż na ekranie" ToolTip.Tip="Enter" Margin="0,0,8,0"
                            Command="{Binding Preview.ShowLiveCommand}" IsVisible="{Binding Preview.CanShowLive}" />
                    <Button Content="Jako następna" Margin="0,0,8,0" Command="{Binding Preview.AddAsNextCommand}" IsVisible="{Binding !Preview.IsFromPlan}" />
                    <Button Content="Na koniec planu" Command="{Binding Preview.AddToEndCommand}" IsVisible="{Binding !Preview.IsFromPlan}" />
                  </WrapPanel>

                  <DockPanel DockPanel.Dock="Top" Margin="0,14,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                      <Button Classes="quiet" Content="Wszystkie części" Command="{Binding Preview.ResetArrangementCommand}" />
                      <ToggleButton Classes="chip" IsChecked="{Binding ShowChords, Mode=OneWay}" Command="{Binding ToggleChordsCommand}" Content="Akordy" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Preview.Chips}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ArrangementChipViewModel">
                          <ToggleButton Classes="chip" IsChecked="{Binding IsIncluded}" Content="{Binding ShortName}" ToolTip.Tip="{Binding Name}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </DockPanel>

                  <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Preview.Slides}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SlideTabViewModel">
                          <Border Classes="slideTile" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,0,0,8" Padding="14,10">
                            <StackPanel Spacing="6">
                              <TextBlock Classes="caption" FontWeight="SemiBold" Text="{Binding Label}" />
                              <ItemsControl ItemsSource="{Binding Slide.Lines}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="p:SlideLine">
                                    <StackPanel>
                                      <TextBlock Classes="chords" Text="{Binding Chords}"
                                                 IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowChords}" />
                                      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                    </StackPanel>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
              </Panel>
            </DockPanel>
          </Border>
        </Grid>

        <GridSplitter Grid.Column="3" Classes="paneDivider" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                      DragCompleted="OnColumnSplitterDragCompleted" ToolTip.Tip="Przeciągnij, aby zmienić szerokość paneli" />

        <!-- NA EKRANIE: to, co widzi sala — bieżąca część, postęp i zapowiedź następnej. -->
        <Border x:Name="LiveColumn" Grid.Column="4" Classes="panel">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Classes="heading" Text="Na ekranie" />
                <TextBlock Classes="caption" Text="To, co widzi sala: bieżąca i następna część" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <ToggleButton Classes="chip liveHeaderAction" Content="Akordy" IsChecked="{Binding ShowChords, Mode=OneWay}"
                              Command="{Binding ToggleChordsCommand}" />
                <Button Classes="quiet liveHeaderAction" Command="{Binding ToggleProjectionThemeCommand}">
                  <Panel>
                    <TextBlock Text="Ekran: jasne tło" IsVisible="{Binding IsProjectionDark}" />
                    <TextBlock Text="Ekran: czarne tło" IsVisible="{Binding !IsProjectionDark}" />
                  </Panel>
                </Button>
              </StackPanel>
            </Grid>

            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,2,0,0">
              <TextBlock Classes="number" Text="{Binding Live.Number}" Margin="0,0,10,0" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Classes="bodyStrong" Text="{Binding Live.Title}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="2" Classes="caption" Text="{Binding Live.ProgressText}" VerticalAlignment="Center" />
            </Grid>
            <ProgressBar DockPanel.Dock="Top" Minimum="0" Maximum="100" Value="{Binding Live.ProgressValue}"
                         Height="5" Margin="0,8,0,0" Foreground="{DynamicResource CandleBrush}" />

            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,8,*" Margin="0,12,0,0">
              <Button Classes="big" Content="Wstecz" Command="{Binding Live.PreviousCommand}" ToolTip.Tip="Backspace, ←, PageUp" />
              <Button Grid.Column="2" Classes="big primary" Content="Dalej" Command="{Binding Live.NextCommand}" ToolTip.Tip="Spacja, →, PageDown" />
            </Grid>

            <ScrollViewer Margin="0,12,0,0">
              <StackPanel Spacing="12">
                <Border Background="{DynamicResource CandleSoftBrush}" BorderBrush="{DynamicResource CandleBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,12,0">
                  <StackPanel>
                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,10">
                      <TextBlock Classes="overline" Foreground="{DynamicResource CandleBrush}" Text="TERAZ" />
                      <TextBlock Grid.Column="1" Classes="caption" FontWeight="SemiBold" Text="{Binding Live.CurrentLabel}"
                                 HorizontalAlignment="Right" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Live.CurrentLines}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="p:SlideLine">
                          <StackPanel Margin="0,0,0,12">
                            <TextBlock Classes="chords" Text="{Binding Chords}"
                                       IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowChords}" />
                            <TextBlock Classes="lead" Text="{Binding Text}" TextWrapping="Wrap" FontWeight="SemiBold" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="12" Padding="16,12" Margin="0,0,12,0"
                        IsVisible="{Binding Live.HasUpcoming}">
                  <StackPanel>
                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                      <TextBlock Classes="overline" Foreground="{DynamicResource MutedBrush}" Text="NASTĘPNA" />
                      <TextBlock Grid.Column="1" Classes="caption" FontWeight="SemiBold" Text="{Binding Live.UpcomingLabel}"
                                 HorizontalAlignment="Right" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Live.NextLines}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="p:SlideLine">
                          <StackPanel Margin="0,0,0,8">
                            <TextBlock Classes="chords" Text="{Binding Chords}"
                                       IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowChords}" />
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>
    </DockPanel>

    <v:PlansOverlay DataContext="{Binding Plans}" IsVisible="{Binding IsOpen}" />
    <v:RemoteOverlay DataContext="{Binding Remote}" IsVisible="{Binding IsOpen}" />

    <Border ZIndex="100" Background="{DynamicResource ScrimBrush}" IsVisible="{Binding Plan.IsRemoveConfirmationOpen}">
      <Border Classes="panel" Width="420" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Spacing="12">
          <TextBlock Classes="heading" Text="Usunąć pieśń z planu?" />
          <TextBlock Classes="heading" Text="{Binding Plan.PendingRemoval.Title}" TextWrapping="Wrap" />
          <TextBlock Classes="caption" Text="Tej operacji nie można cofnąć." />
          <Grid ColumnDefinitions="*,10,*" Margin="0,8,0,0">
            <Button Content="Anuluj" Command="{Binding Plan.CancelRemoveCommand}" />
            <Button Grid.Column="2" Classes="primary" Content="Usuń z planu" Command="{Binding Plan.ConfirmRemoveCommand}" />
          </Grid>
        </StackPanel>
      </Border>
    </Border>
  </Panel>

  <Window.Styles>
    <Style Selector="Border.slideTile">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Button.planItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.liveHeaderAction">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.liveHeaderAction">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- Wiersz planu: podświetla się cały ListBoxItem, nie wewnętrzny przycisk. -->
    <Style Selector="Button.planItem:pointerover /template/ ContentPresenter, Button.planItem:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.removeItem">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="Grid.dragged">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="Border.dropMarker">
      <Setter Property="Height" Value="3" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="{DynamicResource CandleBrush}" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
  </Window.Styles>
</Window>
