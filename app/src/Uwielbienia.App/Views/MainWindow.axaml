<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Uwielbienia.App.ViewModels"
        xmlns:v="using:Uwielbienia.App.Views"
        xmlns:p="using:Uwielbienia.Core.Presentation"
        xmlns:primitives="using:Avalonia.Controls.Primitives"
        x:Class="Uwielbienia.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Uwielbienia"
        Icon="avares://Uwielbienia.App/Assets/icon.ico"
        Width="1280" Height="800" MinWidth="860" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">
  <Panel>
    <DockPanel Margin="16">

      <!-- Pasek górny: plan, stan projekcji, telefon, wygląd -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="4,0,4,14">
        <Button Classes="quiet" Command="{Binding Plans.ShowCommand}" ToolTip.Tip="Plany: otwórz, utwórz, użyj ponownie">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Classes="songTitle" Text="{Binding Plan.Name}" />
            <TextBlock Classes="caption" Text="{Binding Plan.DateText}" VerticalAlignment="Center" IsVisible="{Binding Plan.DateText, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Classes="caption" Text="▾" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <!-- Aktualizacja w kolumnie *, żeby w wąskim oknie zwężała się zamiast wypychać pozostałe przyciski -->
        <DockPanel Grid.Column="1" Margin="8,0" HorizontalAlignment="Right" IsVisible="{Binding IsUpdateAvailable}">
          <Button DockPanel.Dock="Right" Classes="primary" Command="{Binding ApplyUpdateCommand}"
                  ToolTip.Tip="Pobrano nowszą wersję z GitHub — zainstaluj i uruchom ponownie">
            <TextBlock Text="{Binding UpdateVersion, StringFormat='Aktualizuj do {0}'}" TextTrimming="CharacterEllipsis" />
          </Button>
          <TextBlock Classes="caption" VerticalAlignment="Center" Margin="0,0,8,0" Text="{Binding UpdateError}"
                     MaxWidth="240" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding UpdateError}"
                     IsVisible="{Binding UpdateError, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </DockPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button Command="{Binding ToggleProjectionCommand}" ToolTip.Tip="{Binding ProjectionHint}">
            <TextBlock Text="{Binding ProjectionStatus}" />
          </Button>
          <Button Command="{Binding Remote.ShowCommand}" ToolTip.Tip="Sparuj telefon jako pilota albo przeglądarkę jako ekran">
            <TextBlock Text="{Binding Remote.BadgeText}" />
          </Button>
          <Button Command="{Binding ToggleThemeCommand}">
            <Panel>
              <TextBlock Text="Jasny wygląd" IsVisible="{Binding IsDarkTheme}" />
              <TextBlock Text="Ciemny wygląd" IsVisible="{Binding !IsDarkTheme}" />
            </Panel>
          </Button>
        </StackPanel>
      </Grid>

      <Grid x:Name="Columns">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="16*" MinWidth="160" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="42*" MinWidth="280" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="42*" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <!-- PLAN -->
        <Border Classes="panel" Padding="10,14">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="8,0,0,10" MinHeight="34">
              <TextBlock Classes="heading" Text="Plan" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="addSmall" Content="+" ToolTip.Tip="Dodaj pieśń, tekst albo prezentację"
                      Click="OnPlanAddClick" IsVisible="{Binding !Plan.IsEmpty}" />
            </Grid>
            <Button DockPanel.Dock="Top" Classes="addEmpty" Content="+ Dodaj do planu" Margin="4,4,4,0"
                    ToolTip.Tip="Pieśń, tekst albo prezentację (można też upuścić plik prezentacji na plan)"
                    IsVisible="{Binding Plan.IsEmpty}" Click="OnPlanAddClick" />
            <!-- Upuszczony plik prezentacji albo obrazy = nowa prezentacja w planie. -->
            <ListBox x:Name="PlanList" ItemsSource="{Binding Plan.Items}" SelectedItem="{Binding Plan.Selected}"
                     DragDrop.AllowDrop="True">
              <!-- Prawy klik w pustym miejscu listy. -->
              <ListBox.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Dodaj" Click="OnPlanAddClick">
                    <MenuItem.Icon><Path Classes="menuIcon" Data="M8,3 V13 M3,8 H13" /></MenuItem.Icon>
                  </MenuItem>
                </ContextMenu>
              </ListBox.ContextMenu>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PlanItemViewModel">
                  <Grid ColumnDefinitions="*,Auto" Classes.dragged="{Binding IsDragged}">
                    <!-- Pieśń dodana właśnie z telefonu: obwódka na kilka sekund, żeby operator ją zauważył. -->
                    <Border Grid.ColumnSpan="2" Margin="-6,-2" CornerRadius="8" BorderThickness="1.5"
                            BorderBrush="{DynamicResource ChordBrush}" IsVisible="{Binding IsAddedRemotely}"
                            ToolTip.Tip="Dodane z telefonu" />
                    <!-- Prawy klik na pozycji planu. -->
                    <Grid.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Pokaż na ekranie" Click="OnPlanMenuShow">
                          <MenuItem.Icon><Path Classes="menuIcon" Data="M2,3 H14 V11 H2 Z M6,14 H10 M8,11 V14" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Dodaj powyżej" Click="OnPlanMenuAddBefore">
                          <MenuItem.Icon><Path Classes="menuIcon" Data="M3,13 H13 M8,3 V9 M5,6 H11" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Dodaj poniżej" Click="OnPlanMenuAddAfter">
                          <MenuItem.Icon><Path Classes="menuIcon" Data="M3,3 H13 M8,7 V13 M5,10 H11" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Duplikuj" Click="OnPlanMenuDuplicate">
                          <MenuItem.Icon><Path Classes="menuIcon" Data="M5.5,5.5 H13.5 V13.5 H5.5 Z M3,10.5 V2.5 H10.5" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Usuń z planu" Click="OnPlanMenuRemove" Classes="danger">
                          <MenuItem.Icon><Path Classes="menuIcon" Data="{StaticResource DeleteIcon}" /></MenuItem.Icon>
                        </MenuItem>
                      </ContextMenu>
                    </Grid.ContextMenu>
                    <Button Classes="quiet planItem" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Click="OnPlanItemClick" DoubleTapped="OnPlanItemDoubleTapped">
                      <Grid ColumnDefinitions="4,32,*">
                        <Border Background="{DynamicResource CandleBrush}" CornerRadius="2" IsVisible="{Binding IsLive}" Margin="0,2" />
<Panel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0">
                          <TextBlock Classes="number" Text="{Binding Number}" IsVisible="{Binding IsSong}" />
                          <Ellipse Classes="textDot" IsVisible="{Binding IsText}" />
                          <Border Classes="slideMark" IsVisible="{Binding IsPresentation}" />
                          <Path Classes="videoMark" IsVisible="{Binding IsVideo}" />
                          <Path Classes="kioskMark" IsVisible="{Binding IsKiosk}" />
                        </Panel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                          <TextBlock Classes="bodyStrong" Classes.textItem="{Binding IsText}" Classes.presentationItem="{Binding IsMedia}"
                                     Text="{Binding Title}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="caption" Text="{Binding Note}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Note}"
                                     IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNotNull}}" />
                          <TextBlock Classes="caption" Text="Dodane z telefonu" Foreground="{DynamicResource ChordBrush}"
                                     IsVisible="{Binding IsAddedRemotely}" />
                        </StackPanel>
                      </Grid>
                    </Button>
                    <Button Grid.Column="1" Classes="quiet removeItem" Content="✕" ToolTip.Tip="Usuń z planu" VerticalAlignment="Center"
                            Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).Plan.RequestRemoveCommand}" CommandParameter="{Binding}" />
                    <!-- Miejsce upuszczenia przy zmianie kolejności -->
                    <Border Grid.ColumnSpan="2" Classes="dropMarker" VerticalAlignment="Top" Margin="0,-6,0,0"
                            IsVisible="{Binding IsDropBefore}" />
                    <Border Grid.ColumnSpan="2" Classes="dropMarker" VerticalAlignment="Bottom" Margin="0,0,0,-6"
                            IsVisible="{Binding IsDropAfter}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Classes="paneDivider" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                      DragCompleted="OnColumnSplitterDragCompleted" />

        <!-- PIEŚŃ: pozycja wybrana w planie — czytanie i edycja; nie zmienia ekranu (poza układem części granej pieśni). -->
        <Border Grid.Column="2" Classes="panel" Padding="18,16">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
              <TextBlock Classes="heading" Text="{Binding Preview.ColumnTitle}" VerticalAlignment="Top" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" IsVisible="{Binding Preview.IsViewing}">
                <Button Classes="quiet liveHeaderAction" Content="Edytuj" Command="{Binding Preview.EditCommand}"
                        IsVisible="{Binding Preview.HasSong}" />
                <ToggleButton Classes="chip liveHeaderAction" Content="Akordy" IsChecked="{Binding ShowChords, Mode=OneWay}"
                              Command="{Binding ToggleChordsCommand}" IsVisible="{Binding Preview.HasChordsToggle}" />
              </StackPanel>
            </Grid>


            <Panel>
              <!-- Edycja pieśni lub tekstu zamiast podglądu. -->
              <ContentControl Content="{Binding Preview.Editor}" IsVisible="{Binding Preview.IsEditing}">
                <ContentControl.ContentTemplate>
                  <DataTemplate x:DataType="vm:SongEditorViewModel">
                    <v:SongEditorView />
                  </DataTemplate>
                </ContentControl.ContentTemplate>
              </ContentControl>

              <Panel IsVisible="{Binding Preview.IsViewing}">
              <TextBlock Classes="bodyMuted" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                         IsVisible="{Binding Preview.IsEmpty}" TextAlignment="Center"
                         Text="Wybierz pozycję w planie." />

              <!-- Prezentacja: slajdy jako miniatury; przygotowanie (PowerPoint) trwa w tle. -->
              <ContentControl Content="{Binding Preview.Presentation}" IsVisible="{Binding Preview.HasPresentation}">
                <ContentControl.ContentTemplate>
                  <DataTemplate x:DataType="vm:PresentationViewModel">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Top">
                        <TextBlock Classes="songTitle" Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <TextBlock Classes="caption" Text="{Binding Summary}" VerticalAlignment="Center"
                                     IsVisible="{Binding Summary, Converter={x:Static ObjectConverters.IsNotNull}}" />
                          <TextBlock Classes="caption" Classes.failed="{Binding IsFailed}" Text="{Binding Note}" TextWrapping="Wrap"
                                     VerticalAlignment="Center" IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNotNull}}" />
                          <Button Classes="quiet" Content="Spróbuj ponownie" Command="{Binding RetryCommand}" IsVisible="{Binding IsFailed}" />
                        </StackPanel>
                      </StackPanel>
                      <ScrollViewer Margin="0,14,0,0">
                        <ItemsControl ItemsSource="{Binding Slides}" Margin="0,0,2,0">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PresentationSlideViewModel">
                              <StackPanel Margin="0,0,10,12">
                                <Border Classes="slideThumb">
                                  <Image Source="{Binding Thumbnail^}" Stretch="Uniform" />
                                </Border>
                                <TextBlock Classes="caption" Text="{Binding Label}" Margin="2,4,0,0" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </DockPanel>
                  </DataTemplate>
                </ContentControl.ContentTemplate>
              </ContentControl>
              <!-- Film: plik wskazany na dysku (nie jest kopiowany). -->
              <ContentControl Content="{Binding Preview.Video}" IsVisible="{Binding Preview.HasVideo}">
                <ContentControl.ContentTemplate>
                  <DataTemplate x:DataType="vm:VideoDetailsViewModel">
                    <StackPanel>
                      <TextBlock Classes="songTitle" Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                      <TextBlock Classes="caption" Text="{Binding File}" TextWrapping="Wrap" />
                      <TextBlock Classes="caption failed" Text="Nie ma tego pliku. Gdy wróci na swoje miejsce (np. podłączony pendrive), film będzie gotowy sam." TextWrapping="Wrap"
                                 Margin="0,8,0,0" IsVisible="{Binding IsMissing}" />
                      <TextBlock Classes="caption failed" Text="{Binding Unavailable}" TextWrapping="Wrap" Margin="0,8,0,0"
                                 IsVisible="{Binding Unavailable, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                  </DataTemplate>
                </ContentControl.ContentTemplate>
              </ContentControl>
              <!-- Kiosk: elementy zmieniają się same co kilka sekund; każda zmiana od razu w planie (i na ekranie). -->
              <DockPanel IsVisible="{Binding Preview.HasKiosk}">
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,16,Auto">
                  <TextBox Classes="kioskTitle" Text="{Binding Preview.Kiosk.Title, UpdateSourceTrigger=LostFocus}" PlaceholderText="Nazwa kiosku" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                              ToolTip.Tip="Co ile sekund następny element">
                    <TextBlock Classes="caption" Text="Zmiana co" VerticalAlignment="Center" />
                    <NumericUpDown Value="{Binding Preview.Kiosk.Seconds}" Minimum="2" Maximum="600" Increment="1"
                                   FormatString="0" Width="118" />
                    <TextBlock Classes="caption" Text="s" VerticalAlignment="Center" />
                  </StackPanel>
                </Grid>
                <!-- Przejście między elementami: żaden efekt = przenikanie, jeden = zawsze ten, kilka = losowo jeden z nich. -->
                <StackPanel DockPanel.Dock="Top" Margin="0,12,0,0" Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="caption" Text="Przejście" VerticalAlignment="Center"
                               ToolTip.Tip="Kilka zaznaczonych — za każdym razem losowo jeden; żadne — zwykłe przenikanie" />
                    <CheckBox Grid.Column="1" Content="Powolny zoom zdjęć" IsChecked="{Binding Preview.Kiosk.SlowZoom}" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Preview.Kiosk.Transitions}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel ItemSpacing="6" LineSpacing="6" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TransitionOptionViewModel">
                        <ToggleButton Classes="chip" Content="{Binding Name}" IsChecked="{Binding IsSelected}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <WrapPanel DockPanel.Dock="Bottom" ItemSpacing="8" LineSpacing="8" Margin="0,12,0,0">
                  <Button Classes="addKind" Click="OnKioskAddImagesClick" ToolTip.Tip="Każdy obraz osobnym elementem">
                    <StackPanel>
                      <Path Data="M3,5 H21 V19 H3 Z M3,16 L9,10 L14,15 L17,12 L21,16 M15,8 A1.5,1.5 0 1 1 18,8 A1.5,1.5 0 1 1 15,8 Z" />
                      <TextBlock Text="Obraz" />
                    </StackPanel>
                  </Button>
                  <Button Classes="addKind" Command="{Binding Preview.Kiosk.AddTextCommand}" ToolTip.Tip="Sam napis, z tytułem albo bez">
                    <StackPanel>
                      <Path Data="M4,6 H20 M4,10 H20 M4,14 H14 M4,18 H17" />
                      <TextBlock Text="Napis" />
                    </StackPanel>
                  </Button>
                  <Button Classes="addKind" Click="OnKioskAddPresentationClick" ToolTip.Tip="Plik PowerPoint — każdy slajd osobnym elementem">
                    <StackPanel>
                      <Path Data="M3,4 H21 V15 H3 Z M12,15 V19 M8,20 H16" />
                      <TextBlock Text="Prezentacja" />
                    </StackPanel>
                  </Button>
                </WrapPanel>
                <TextBlock DockPanel.Dock="Bottom" Classes="caption failed" Text="{Binding Preview.Kiosk.Error}" TextWrapping="Wrap" Margin="0,10,0,0"
                           IsVisible="{Binding Preview.Kiosk.Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <Panel Margin="0,14,0,0">
                  <TextBlock Classes="bodyMuted" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                             IsVisible="{Binding Preview.Kiosk.IsEmpty}" Text="Dodaj obrazy, napisy albo prezentację." />
                  <ScrollViewer>
                    <ItemsControl x:Name="KioskEntriesList" ItemsSource="{Binding Preview.Kiosk.Entries}" Margin="0,0,12,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:KioskEntryViewModel">
                          <Panel Classes.dragged="{Binding IsDragged}">
                            <Border Classes="slideTile" Margin="0,0,0,8" Padding="10">
                              <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                <!-- uchwyt do przeciągania -->
                                <TextBlock Classes="caption kioskHandle" Text="⠿" VerticalAlignment="Center" Padding="2,8,8,8"
                                           Background="Transparent" Cursor="SizeNorthSouth" />
                                <Border Grid.Column="1" Classes="slideThumb" Width="150" Height="84" Margin="0,0,12,0" VerticalAlignment="Top"
                                        IsVisible="{Binding HasImage}">
                                  <Image Source="{Binding Thumbnail^}" Stretch="Uniform" />
                                </Border>
                                <StackPanel Grid.Column="2" Spacing="6">
                                  <TextBox Text="{Binding Title, UpdateSourceTrigger=LostFocus}" PlaceholderText="Tytuł (opcjonalnie)" />
                                  <TextBox Text="{Binding Text, UpdateSourceTrigger=LostFocus}" PlaceholderText="{Binding TextHint}"
                                           AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />
                                  <TextBlock Classes="caption" Classes.failed="{Binding IsFailed}" Text="{Binding Note}" TextWrapping="Wrap"
                                             IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                </StackPanel>
                                <Button Grid.Column="3" Classes="quiet removeItem" Content="✕" ToolTip.Tip="Usuń z kiosku" VerticalAlignment="Top"
                                        Margin="6,0,0,0"
                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Preview.Kiosk.RemoveCommand}"
                                        CommandParameter="{Binding}" />
                              </Grid>
                            </Border>
                            <Border Classes="dropMarker" VerticalAlignment="Top" Margin="0,-6,0,0" IsVisible="{Binding IsDropBefore}" />
                            <Border Classes="dropMarker" VerticalAlignment="Bottom" Margin="0,0,0,2" IsVisible="{Binding IsDropAfter}" />
                          </Panel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Panel>
              </DockPanel>
              <DockPanel IsVisible="{Binding Preview.HasSong}">
                <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*">
                  <TextBlock Classes="displayNumber" Text="{Binding Preview.Number}" Margin="0,2,14,0" VerticalAlignment="Top"
                             IsVisible="{Binding Preview.Number, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <StackPanel Grid.Column="1">
                    <!-- Długi tytuł (np. pierwszy wers tekstu bez tytułu) w jednej linii z „…”; pełny w podpowiedzi. -->
                    <TextBlock Classes="songTitle" Text="{Binding Preview.Title}" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Preview.Title}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock Classes="caption" Text="{Binding Preview.Category}" />
                      <TextBlock Classes="caption" Foreground="{DynamicResource CandleBrush}" Text="{Binding Preview.OriginText}"
                                 IsVisible="{Binding Preview.OriginText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                  </StackPanel>
                </Grid>

                <!-- Układ pieśni w tym planie: kolejność (przeciąganie za nagłówek), powtórzenie, usunięcie, pominięcie. -->
                <ScrollViewer Margin="0,14,0,0">
                  <StackPanel Margin="0,0,12,0">
                  <ItemsControl x:Name="PartsList" ItemsSource="{Binding Preview.Parts}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SongPartViewModel">
                        <Panel Classes.dragged="{Binding IsDragged}">
                        <Border Classes="slideTile" Classes.excluded="{Binding !IsIncluded}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,0,0,8" Padding="14,10">
                          <Border.ContextMenu>
                            <ContextMenu>
                              <MenuItem Header="Powtórz" Click="OnPartDuplicate"
                                        IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).Preview.CanReorderParts}">
                                <MenuItem.Icon><Path Classes="menuIcon" Data="M2.5,8 V6.5 A3,3 0 0 1 5.5,3.5 H13 M10.5,1 L13,3.5 L10.5,6 M13.5,8 V9.5 A3,3 0 0 1 10.5,12.5 H3 M5.5,15 L3,12.5 L5.5,10" /></MenuItem.Icon>
                              </MenuItem>
                              <MenuItem Header="Usuń" Click="OnPartRemove" Classes="danger">
                                <MenuItem.Icon><Path Classes="menuIcon" Data="{StaticResource DeleteIcon}" /></MenuItem.Icon>
                              </MenuItem>
                            </ContextMenu>
                          </Border.ContextMenu>
                          <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                              <!-- Nagłówek części jest uchwytem do przeciągania (tylko pieśń — tekst ma kolejność z edytora). -->
                              <StackPanel Classes="partHandle" Orientation="Horizontal" Spacing="8" Background="Transparent"
                                          Cursor="{Binding $parent[Window].((vm:MainViewModel)DataContext).Preview.CanReorderParts, Converter={x:Static v:MainWindow.DragCursor}}"
                                          VerticalAlignment="Center">
                                <TextBlock Classes="caption" Text="⠿" VerticalAlignment="Center"
                                           IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).Preview.CanReorderParts}" />
                                <TextBlock Classes="caption" FontWeight="SemiBold" Text="{Binding Name}" VerticalAlignment="Center" />
                              </StackPanel>
                              <Button Grid.Column="1" Classes="quiet partMenu" Content="⋯" ToolTip.Tip="Powtórz albo usuń"
                                      Click="OnPartMenuClick" Margin="0,0,6,0" />
                              <CheckBox Grid.Column="2" IsChecked="{Binding IsIncluded}" MinWidth="0" Padding="0"
                                        ToolTip.Tip="Śpiewamy tę część" />
                            </Grid>
                            <ItemsControl Classes="partLines" ItemsSource="{Binding Lines}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="p:SlideLine">
                                  <StackPanel>
                                    <TextBlock Classes="chords" Text="{Binding Chords}" Classes.empty="{Binding Chords, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                                               Classes.hidden="{Binding !$parent[Window].((vm:MainViewModel)DataContext).ShowChords}" />
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                  </StackPanel>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Border>
                        <Border Classes="dropMarker" VerticalAlignment="Top" Margin="0,-6,0,0" IsVisible="{Binding IsDropBefore}" />
                        <Border Classes="dropMarker" VerticalAlignment="Bottom" Margin="0,0,0,2" IsVisible="{Binding IsDropAfter}" />
                        </Panel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Classes="addEmpty" Content="+ Przywróć usuniętą część" Click="OnAddPartClick" Margin="0,2,0,0"
                          IsVisible="{Binding Preview.HasRemovedSections}" />
                  </StackPanel>
                </ScrollViewer>
              </DockPanel>
              </Panel>
            </Panel>
          </DockPanel>
        </Border>

        <GridSplitter Grid.Column="3" Classes="paneDivider" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                      DragCompleted="OnColumnSplitterDragCompleted" />

        <!-- NA EKRANIE: to, co widzi sala — bieżąca część, postęp i zapowiedź następnej. -->
        <Border x:Name="LiveColumn" Grid.Column="4" Classes="panel">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
              <TextBlock Classes="heading" Text="Na ekranie" VerticalAlignment="Top" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <ToggleButton Classes="chip liveHeaderAction" Content="Akordy" IsChecked="{Binding ShowChords, Mode=OneWay}"
                              Command="{Binding ToggleChordsCommand}" />
                <Button Classes="quiet liveHeaderAction" Command="{Binding ToggleProjectionThemeCommand}">
                  <Panel>
                    <TextBlock Text="Ekran: jasne tło" IsVisible="{Binding IsProjectionDark}" />
                    <TextBlock Text="Ekran: czarne tło" IsVisible="{Binding !IsProjectionDark}" />
                  </Panel>
                </Button>
              </StackPanel>
            </Grid>

            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,2,0,0" IsVisible="{Binding Live.HasItem}">
              <TextBlock Classes="number" Text="{Binding Live.Number}" Margin="0,0,10,0" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Classes="bodyStrong" Text="{Binding Live.Title}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="2" Classes="caption" Text="{Binding Live.ProgressText}" VerticalAlignment="Center" />
            </Grid>
            <ProgressBar DockPanel.Dock="Top" Minimum="0" Maximum="100" Value="{Binding Live.ProgressValue}"
                         Height="5" Margin="0,8,0,0" Foreground="{DynamicResource CandleBrush}" IsVisible="{Binding Live.HasItem}" />

            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,8,*" Margin="0,12,0,0" IsVisible="{Binding Live.HasItem}">
              <Button Classes="big" Content="Wstecz" Command="{Binding Live.PreviousCommand}" ToolTip.Tip="Backspace, ←, PageUp" />
              <Button Grid.Column="2" Classes="big primary" Content="Dalej" Command="{Binding Live.NextCommand}" ToolTip.Tip="Spacja, →, PageDown" />
            </Grid>

            <!-- Pusty ekran: bez przycisków i ramek, które nie miałyby czego pokazywać. -->
            <Panel>
              <TextBlock Classes="bodyMuted" Text="Ekran jest pusty" HorizontalAlignment="Center" VerticalAlignment="Center"
                         IsVisible="{Binding !Live.HasItem}" />
              <ScrollViewer Margin="0,12,0,0" IsVisible="{Binding Live.HasItem}">
                <StackPanel Spacing="12">
                  <Border Background="{DynamicResource CandleSoftBrush}" BorderBrush="{DynamicResource CandleBrush}"
                          BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,12,0">
                    <StackPanel>
                      <!-- Ramka w kolorze świecy sama mówi „to jest na ekranie” — bez napisu „TERAZ”. -->
                      <TextBlock Classes="caption" FontWeight="SemiBold" Text="{Binding Live.CurrentLabel}"
                                 HorizontalAlignment="Right" Margin="0,0,0,10" />
                      <Border Classes="slideThumb" IsVisible="{Binding Live.HasCurrentImage}" Margin="0,0,0,4">
                        <Image Source="{Binding Live.CurrentImage^}" Stretch="Uniform" />
                      </Border>
                      <!-- Kiosk: ten sam obraz co na rzutniku, elementy zmieniają się same. -->
                      <Border Classes="slideThumb" IsVisible="{Binding Live.HasCurrentKiosk}" Margin="0,0,0,4">
                        <v:SlideView Page="{Binding Live.CurrentKiosk}"
                                     SlideBackground="{Binding Live.Appearance.Background}"
                                     SlideForeground="{Binding Live.Appearance.Foreground}"
                                     SlideMuted="{Binding Live.Appearance.Muted}"
                                     SlideAccent="{Binding Live.Appearance.Accent}"
                                     SlideTitle="{Binding Live.Appearance.Title}" />
                      </Border>
                      <!-- Film: ten sam obraz co na rzutniku, pauza (spacja), przewijanie i czas. -->
                      <StackPanel IsVisible="{Binding Live.HasCurrentVideo}" Spacing="8" Margin="0,0,0,4">
                        <!-- Kliknięcie w film = pauza / wznowienie (jak w odtwarzaczu i na rzutniku). -->
                        <Border Classes="slideThumb" Background="Transparent" Cursor="Hand" Tapped="OnVideoPreviewTapped">
                          <v:VideoSurface Frames="{Binding Live.Video.Frames}" />
                        </Border>
                        <!-- Jak w odtwarzaczu: postęp na całą szerokość, pod nim sterowanie i czas, z prawej obraz
                             względem dźwięku (rzadkie ustawienie — małe, wyciszone, kolor akordów, gdy nie jest zerem). -->
                        <Slider Minimum="0" Maximum="{Binding Live.Video.DurationSeconds}" Margin="0,-6,0,-10"
                                Value="{Binding Live.Video.PositionSeconds}" Focusable="False" />
                        <Grid ColumnDefinitions="Auto,12,*,8,Auto">
                          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button Classes="videoSkip" Content="−15 s" Command="{Binding Live.Video.SkipBackCommand}" ToolTip.Tip="15 sekund wstecz" />
                            <Button Classes="videoPlay" Command="{Binding Live.Video.TogglePauseCommand}"
                                    ToolTip.Tip="Pauza / odtwarzanie (spacja albo kliknięcie w film)">
                              <Panel>
                                <Path Data="M3,2 L5.6,2 L5.6,14 L3,14 Z M10.4,2 L13,2 L13,14 L10.4,14 Z" IsVisible="{Binding Live.Video.IsPlaying}" />
                                <Path Data="M4.5,2 L14,8 L4.5,14 Z" IsVisible="{Binding !Live.Video.IsPlaying}" />
                              </Panel>
                            </Button>
                            <Button Classes="videoSkip" Content="+15 s" Command="{Binding Live.Video.SkipForwardCommand}" ToolTip.Tip="15 sekund do przodu" />
                          </StackPanel>
                          <TextBlock Grid.Column="2" Classes="caption videoTime" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding Live.Video.PositionText}" Foreground="{DynamicResource TextBrush}" />
                            <Run Text=" / " />
                            <Run Text="{Binding Live.Video.DurationText}" />
                          </TextBlock>
                          <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                                      ToolTip.Tip="Obraz względem dźwięku — gdy rzutnik spóźnia obraz ( [ / ] )">
                            <TextBlock Classes="caption" Text="Obraz" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <Button Classes="videoStep" Command="{Binding Live.Video.PictureEarlierCommand}" ToolTip.Tip="Obraz wcześniej o 0,1 s ( [ )">
                              <Path Data="M10,3 L5,8 L10,13" />
                            </Button>
                            <Button Classes="videoOffset" Classes.set="{Binding Live.Video.HasPictureOffset}"
                                    Content="{Binding Live.Video.PictureOffsetText}" Command="{Binding Live.Video.ResetPictureOffsetCommand}"
                                    ToolTip.Tip="Kliknij, żeby wyzerować" />
                            <Button Classes="videoStep" Command="{Binding Live.Video.PictureLaterCommand}" ToolTip.Tip="Obraz później o 0,1 s ( ] )">
                              <Path Data="M6,3 L11,8 L6,13" />
                            </Button>
                          </StackPanel>
                        </Grid>
                        <Border IsVisible="{Binding Live.Video.IsPromptVisible}" Background="{DynamicResource CandleSoftBrush}"
                                CornerRadius="8" Padding="12,8">
                          <StackPanel>
                            <TextBlock Classes="bodyStrong" Text="Przytrzymaj „do tyłu” — poprzednia pozycja planu" />
                            <TextBlock Classes="bodyStrong" Text="Przytrzymaj „do przodu” — następna pozycja planu" />
                          </StackPanel>
                        </Border>
                        <TextBlock Classes="caption failed" Text="{Binding Live.Video.Error}" TextWrapping="Wrap"
                                   IsVisible="{Binding Live.Video.Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      </StackPanel>
                      <ItemsControl ItemsSource="{Binding Live.CurrentLines}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="p:SlideLine">
                            <StackPanel Margin="{Binding StartsPart, Converter={x:Static v:SlideConverters.PartGap}, ConverterParameter=12}">
                              <TextBlock Classes="chords" Text="{Binding Chords}" Classes.empty="{Binding Chords, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                                         Classes.hidden="{Binding !$parent[Window].((vm:MainViewModel)DataContext).ShowChords}" />
                              <TextBlock Classes="lead" Text="{Binding Text}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,12"
                                         FontStyle="{Binding IsChorus, Converter={x:Static v:SlideConverters.ChorusStyle}}" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>

                  <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="12" Padding="16,12" Margin="0,0,12,0"
                          IsVisible="{Binding Live.HasUpcoming}">
                    <StackPanel>
                      <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                        <TextBlock Classes="overline" Foreground="{DynamicResource MutedBrush}" Text="NASTĘPNA" />
                        <TextBlock Grid.Column="1" Classes="caption" FontWeight="SemiBold" Text="{Binding Live.UpcomingLabel}"
                                   HorizontalAlignment="Right" />
                      </Grid>
                      <Border Classes="slideThumb" IsVisible="{Binding Live.HasNextImage}" MaxWidth="320" HorizontalAlignment="Left">
                        <Image Source="{Binding Live.NextImage^}" Stretch="Uniform" />
                      </Border>
                      <ItemsControl ItemsSource="{Binding Live.NextLines}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="p:SlideLine">
                            <StackPanel Margin="{Binding StartsPart, Converter={x:Static v:SlideConverters.PartGap}, ConverterParameter=8}">
                              <TextBlock Classes="chords" Text="{Binding Chords}" Classes.empty="{Binding Chords, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                                         Classes.hidden="{Binding !$parent[Window].((vm:MainViewModel)DataContext).ShowChords}" />
                              <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,0,0,8"
                                         FontStyle="{Binding IsChorus, Converter={x:Static v:SlideConverters.ChorusStyle}}" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>

                </StackPanel>
              </ScrollViewer>
            </Panel>
          </DockPanel>
        </Border>
      </Grid>
    </DockPanel>

    <v:PlansOverlay DataContext="{Binding Plans}" IsVisible="{Binding IsOpen}" />
    <v:RemoteOverlay DataContext="{Binding Remote}" IsVisible="{Binding IsOpen}" />

    <!-- Dodaj do planu: wyszukiwarka pieśni i tekstów; wybór od razu wstawia w miejsce wskazane w planie. -->
    <Border x:Name="PlanAddScrim" ZIndex="90" Background="{DynamicResource ScrimBrush}" IsVisible="{Binding PlanAdd.IsOpen}"
            PointerPressed="OnPlanAddScrimPressed">
      <Border Classes="panel dialog" Width="780" MaxHeight="640" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,96,0,24">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBlock Classes="heading" Text="Dodaj do planu" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="quiet closeButton" Content="✕" ToolTip.Tip="Zamknij" Command="{Binding PlanAdd.CloseCommand}" />
          </Grid>
          <TextBox x:Name="PlanAddBox" DockPanel.Dock="Top" Classes="search" Text="{Binding PlanAdd.Query}" Margin="0,0,0,10"
                   PlaceholderText="Szukaj pieśni lub tekstu: numer albo słowa" />
          <!-- Nowa pozycja: każdy rodzaj z własną ikoną (cały rząd to dodawanie, więc bez „+”). -->
          <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,12,Auto" Margin="0,12,0,0">
            <WrapPanel ItemSpacing="8" LineSpacing="8">
              <Button Classes="addKind" Command="{Binding PlanAdd.NewSongCommand}" ToolTip.Tip="Nowa pieśń z akordami">
                <StackPanel>
                  <Path Data="M9,18 A3,3 0 1 1 3,18 A3,3 0 1 1 9,18 Z M9,18 V5 L20,3 V16 M20,16 A3,3 0 1 1 14,16 A3,3 0 1 1 20,16 Z" />
                  <TextBlock Text="Nowa pieśń" />
                </StackPanel>
              </Button>
              <Button Classes="addKind" Command="{Binding PlanAdd.NewTextCommand}" ToolTip.Tip="Część Mszy, modlitwa, ogłoszenie">
                <StackPanel>
                  <Path Data="M4,6 H20 M4,10 H20 M4,14 H14 M4,18 H17" />
                  <TextBlock Text="Nowy tekst" />
                </StackPanel>
              </Button>
              <Button Classes="addKind" Click="OnAddPresentationClick" ToolTip.Tip="Plik PowerPoint albo kilka obrazów jako slajdy">
                <StackPanel>
                  <Path Data="M3,4 H21 V15 H3 Z M12,15 V19 M8,20 H16" />
                  <TextBlock Text="Prezentacja" />
                </StackPanel>
              </Button>
              <Button Classes="addKind" Click="OnAddImagesClick" ToolTip.Tip="Każdy obraz osobno, na cały ekran">
                <StackPanel>
                  <Path Data="M3,5 H21 V19 H3 Z M3,16 L9,10 L14,15 L17,12 L21,16 M15,8 A1.5,1.5 0 1 1 18,8 A1.5,1.5 0 1 1 15,8 Z" />
                  <TextBlock Text="Obraz" />
                </StackPanel>
              </Button>
              <Button Classes="addKind" Click="OnAddVideoClick" ToolTip.Tip="mp4, mkv, avi, mov… — plik zostaje na swoim miejscu">
                <StackPanel>
                  <Path Data="M3,5 H21 V19 H3 Z M10,9 L15,12 L10,15 Z" />
                  <TextBlock Text="Film" />
                </StackPanel>
              </Button>
              <Button Classes="addKind" Command="{Binding PlanAdd.NewKioskCommand}" ToolTip.Tip="Obrazy i napisy zmieniające się same co kilka sekund">
                <StackPanel>
                  <Path Data="M7,4 H21 V15 M3,8 H17 V20 H3 Z" />
                  <TextBlock Text="Kiosk" />
                </StackPanel>
              </Button>
            </WrapPanel>
            <Button Grid.Column="2" Classes="primary" Content="Wybierz" Command="{Binding PlanAdd.AddCommand}" VerticalAlignment="Bottom"
                    CommandParameter="{x:Null}" IsEnabled="{Binding PlanAdd.HasSelection}" />
          </Grid>
          <TextBlock DockPanel.Dock="Bottom" Classes="caption failed" Text="{Binding PlanAdd.Error}" TextWrapping="Wrap" Margin="0,10,0,0"
                     IsVisible="{Binding PlanAdd.Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <!-- Klik zaznacza; dodaje „Wybierz”, Enter albo dwuklik. -->
          <ListBox ItemsSource="{Binding PlanAdd.Results}" SelectedItem="{Binding PlanAdd.Selected}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SongResultViewModel">
                <Grid ColumnDefinitions="40,*" Background="Transparent" DoubleTapped="OnPlanAddResultDoubleTapped">
                  <Panel VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Classes="number" Text="{Binding Number}" IsVisible="{Binding !IsText}" />
                    <Ellipse Classes="textDot" IsVisible="{Binding IsText}" Margin="6,0,0,0" />
                  </Panel>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Classes="bodyStrong" Classes.textItem="{Binding IsText}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="caption" Text="{Binding FirstLine}" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding FirstLine, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Border>

    <Border ZIndex="100" Background="{DynamicResource ScrimBrush}" IsVisible="{Binding Plan.IsRemoveConfirmationOpen}">
      <Border Classes="panel dialog" Width="400" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Spacing="6">
          <TextBlock Classes="heading" Text="Usunąć z planu?" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Classes="number" Text="{Binding Plan.PendingRemoval.Number}" VerticalAlignment="Center" />
            <TextBlock Classes="bodyStrong" Text="{Binding Plan.PendingRemoval.Title}" TextWrapping="Wrap" MaxWidth="320" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Anuluj" Command="{Binding Plan.CancelRemoveCommand}" />
            <Button Classes="danger" Content="Usuń" Command="{Binding Plan.ConfirmRemoveCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Panel>

  <Window.Styles>
    <Style Selector="Border.slideTile">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <!-- Część pominięta w tym wykonaniu: przygaszona, ale widoczna, żeby można ją było przywrócić. -->
    <Style Selector="Border.slideTile.excluded ItemsControl.partLines">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <!-- Wiersz akordów znika bez pustego miejsca, gdy akordy są wyłączone albo wers ich nie ma. -->
    <Style Selector="TextBlock.chords.hidden, TextBlock.chords.empty">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- Tekst (część Mszy, modlitwa…) odróżnia się od pieśni kolorem; zamiast numeru ma kropkę. -->
    <Style Selector="TextBlock.textItem">
      <Setter Property="Foreground" Value="{DynamicResource TextItemBrush}" />
    </Style>
    <!-- Prezentacja: znak slajdu zamiast numeru i własny kolor. -->
    <Style Selector="TextBlock.presentationItem">
      <Setter Property="Foreground" Value="{DynamicResource PresentationItemBrush}" />
    </Style>
    <Style Selector="Border.slideMark">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="10" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="BorderBrush" Value="{DynamicResource PresentationItemBrush}" />
    </Style>
    <!-- Film: znak odtwarzania zamiast numeru, w kolorze prezentacji. -->
    <Style Selector="Path.videoMark">
      <Setter Property="Data" Value="M 0,0 L 10,6 L 0,12 Z" />
      <Setter Property="Fill" Value="{DynamicResource PresentationItemBrush}" />
    </Style>
    <!-- Kiosk: dwa nałożone slajdy (zmieniają się same), w kolorze prezentacji. -->
    <Style Selector="Path.kioskMark">
      <Setter Property="Data" Value="M 4,0 H 14 V 8 M 0,3 H 10 V 11 H 0 Z" />
      <Setter Property="Stroke" Value="{DynamicResource PresentationItemBrush}" />
      <Setter Property="StrokeThickness" Value="1.5" />
    </Style>
    <Style Selector="TextBox.kioskTitle">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.slideThumb">
      <Setter Property="Background" Value="Black" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="MinHeight" Value="60" />
    </Style>
    <Style Selector="TextBlock.failed">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="Ellipse.textDot">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="Fill" Value="{DynamicResource TextItemBrush}" />
    </Style>
    <Style Selector="Button.addSmall">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.addEmpty">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="12,12" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="Button.partMenu">
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="Button.addButton">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="46" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.planItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.liveHeaderAction">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.liveHeaderAction">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- Wiersz planu: podświetla się cały ListBoxItem, nie wewnętrzny przycisk. -->
    <Style Selector="Button.planItem:pointerover /template/ ContentPresenter, Button.planItem:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.removeItem">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="Grid.dragged, Panel.dragged">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <!-- „Dodaj do planu”: rodzaj pozycji — ikona (obrys w kolorze tekstu przycisku) i nazwa. -->
    <Style Selector="Button.addKind > StackPanel">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="8" />
    </Style>
    <Style Selector="Button.addKind Path">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="StrokeThickness" Value="1.8" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Film w „Na ekranie”: pauza = okrągły przycisk w kolorze świecy, reszta bez tła. -->
    <Style Selector="Button.videoPlay">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Background" Value="{DynamicResource CandleBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.videoPlay:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CandleBrush}" />
      <Setter Property="Opacity" Value="0.9" />
    </Style>
    <Style Selector="Button.videoPlay Path">
      <Setter Property="Width" Value="15" />
      <Setter Property="Height" Value="15" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Fill" Value="{DynamicResource OnCandleBrush}" />
    </Style>
    <Style Selector="Button.videoSkip, Button.videoStep, Button.videoOffset">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontFeatures" Value="+tnum" />
    </Style>
    <Style Selector="Button.videoSkip">
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="TextBlock.videoTime">
      <Setter Property="FontFeatures" Value="+tnum" />
    </Style>
    <Style Selector="Button.videoStep">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.videoStep Path">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="StrokeThickness" Value="1.8" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Stroke" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="Button.videoOffset">
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="MinWidth" Value="58" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="Button.videoOffset.set">
      <Setter Property="Foreground" Value="{DynamicResource ChordBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.dropMarker">
      <Setter Property="Height" Value="3" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="{DynamicResource CandleBrush}" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
  </Window.Styles>
</Window>
