<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Uwielbienia.App.ViewModels"
             x:Class="Uwielbienia.App.Views.PlansOverlay"
             x:DataType="vm:PlansViewModel">
  <Border Background="{DynamicResource ScrimBrush}">
    <Border Classes="panel" Width="880" MaxHeight="760" Padding="24" VerticalAlignment="Center">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
          <TextBlock Classes="songTitle" Text="Plany" />
          <Button Grid.Column="1" Classes="quiet" Content="Zamknij  Esc" Command="{Binding CloseCommand}" />
        </Grid>

        <!-- Nowy plan -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,18">
          <Grid ColumnDefinitions="*,12,Auto,12,Auto,12,Auto">
            <TextBox Text="{Binding NewName}" PlaceholderText="Nazwa, np. Uwielbienie 25 września 2026" />
            <CalendarDatePicker Grid.Column="2" SelectedDate="{Binding NewDate}" IsEnabled="{Binding !NewIsTemplate}" />
            <CheckBox Grid.Column="4" Content="Szablon" IsChecked="{Binding NewIsTemplate}" ToolTip.Tip="Plan bez daty do wielokrotnego użycia, np. Próba z dziećmi" />
            <Button Grid.Column="6" Classes="primary" Content="Utwórz plan" Command="{Binding CreateCommand}" />
          </Grid>
        </Border>

        <Grid ColumnDefinitions="*,24,*">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Classes="heading" Text="Wydarzenia" Margin="0,0,0,8" />
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Events}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PlanSummaryViewModel">
                    <Border Classes="planRow" Classes.open="{Binding IsOpen}">
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Classes="caption" Text="{Binding Details}" />
                        <StackPanel Orientation="Horizontal" Spacing="2" Margin="-8,4,0,0">
                          <Button Classes="quiet" Content="Otwórz"
                                  Command="{Binding $parent[UserControl].((vm:PlansViewModel)DataContext).OpenPlanCommand}" CommandParameter="{Binding}" />
                          <Button Classes="quiet" Content="Użyj ponownie" ToolTip.Tip="Kopia z dzisiejszą datą"
                                  Command="{Binding $parent[UserControl].((vm:PlansViewModel)DataContext).ReuseCommand}" CommandParameter="{Binding}" />
                          <Button Classes="quiet" Content="Jako szablon"
                                  Command="{Binding $parent[UserControl].((vm:PlansViewModel)DataContext).SaveAsTemplateCommand}" CommandParameter="{Binding}" />
                          <Button Classes="quiet" Content="Usuń" IsVisible="{Binding !IsOpen}"
                                  Command="{Binding $parent[UserControl].((vm:PlansViewModel)DataContext).DeleteCommand}" CommandParameter="{Binding}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>

          <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Classes="heading" Text="Szablony" Margin="0,0,0,8" />
            <TextBlock DockPanel.Dock="Top" Classes="caption" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="Stałe zestawy, np. Próba z dziećmi. „Użyj ponownie” tworzy z nich plan na dziś." />
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Templates}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PlanSummaryViewModel">
                    <Border Classes="planRow" Classes.open="{Binding IsOpen}">
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Classes="caption" Text="{Binding Details}" />
                        <StackPanel Orientation="Horizontal" Spacing="2" Margin="-8,4,0,0">
                          <Button Classes="quiet" Content="Użyj ponownie"
                                  Command="{Binding $parent[UserControl].((vm:PlansViewModel)DataContext).ReuseCommand}" CommandParameter="{Binding}" />
                          <Button Classes="quiet" Content="Edytuj"
                                  Command="{Binding $parent[UserControl].((vm:PlansViewModel)DataContext).OpenPlanCommand}" CommandParameter="{Binding}" />
                          <Button Classes="quiet" Content="Usuń" IsVisible="{Binding !IsOpen}"
                                  Command="{Binding $parent[UserControl].((vm:PlansViewModel)DataContext).DeleteCommand}" CommandParameter="{Binding}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Grid>
      </DockPanel>
    </Border>
  </Border>

  <UserControl.Styles>
    <Style Selector="Border.planRow">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="Border.planRow.open">
      <Setter Property="Background" Value="{DynamicResource CandleSoftBrush}" />
    </Style>
  </UserControl.Styles>
</UserControl>
