<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Uwielbienia.App.ViewModels"
             xmlns:s="using:Uwielbienia.Core.Songs"
             x:Class="Uwielbienia.App.Views.SongEditorView"
             x:DataType="vm:SongEditorViewModel">
  <DockPanel>
    <TextBox x:Name="TitleBox" DockPanel.Dock="Top" Text="{Binding Title}" PlaceholderText="{Binding TitlePlaceholder}" Margin="0,0,0,14" />


    <!-- Akcje na dole: zapis zawsze lokalny (na tym komputerze). -->
    <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,12,0,0">
      <TextBlock Classes="bodyStrong" Foreground="{DynamicResource DangerBrush}" Text="{Binding Error}" TextWrapping="Wrap"
                 IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

      <Border Classes="confirm" IsVisible="{Binding IsDeleteConfirmationOpen}">
        <Grid ColumnDefinitions="*,Auto,10,Auto">
          <TextBlock Classes="bodyStrong" TextWrapping="Wrap" VerticalAlignment="Center" Text="Usunąć na stałe?" />
          <Button Grid.Column="1" Content="Anuluj" Command="{Binding CancelDeleteCommand}" />
          <Button Grid.Column="3" Classes="danger" Content="Usuń" Command="{Binding ConfirmDeleteCommand}" />
        </Grid>
      </Border>

      <Grid ColumnDefinitions="Auto,*,Auto,10,Auto" IsVisible="{Binding !IsDeleteConfirmationOpen}">
        <StackPanel Orientation="Horizontal" Spacing="4" Margin="-8,0,0,0">
          <Button Classes="quiet dangerText" Content="Usuń…" Command="{Binding RequestDeleteCommand}" IsVisible="{Binding CanDelete}" />
          <Button Classes="quiet" Content="Przywróć oryginał" Command="{Binding RevertCommand}" IsVisible="{Binding CanRevert}"
                  ToolTip.Tip="Usuwa zmiany zrobione na tym komputerze" />
        </StackPanel>
        <Button Grid.Column="2" Content="Anuluj" Command="{Binding CancelCommand}" />
        <Button Grid.Column="4" Classes="primary" Content="Zapisz" Command="{Binding SaveCommand}" />
      </Grid>
    </StackPanel>

    <ScrollViewer>
      <StackPanel Margin="0,0,12,0" Spacing="8">
        <ItemsControl ItemsSource="{Binding Parts}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PartEditorViewModel">
              <Border Classes="slideTile" Padding="12,10" Margin="0,0,0,8">
                <!-- Pieśń: rodzaj części nad treścią; tekst: sama treść. ✕ zawsze w prawym górnym rogu. -->
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                  <ComboBox ItemsSource="{Binding $parent[ItemsControl].((vm:SongEditorViewModel)DataContext).PartTypes}"
                            SelectedItem="{Binding Type}" MinWidth="180" Margin="0,0,0,8"
                            IsVisible="{Binding $parent[ItemsControl].((vm:SongEditorViewModel)DataContext).IsSong}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="s:SongPartType">
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBox Grid.Row="1" Classes="lyrics" Text="{Binding Text}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96"
                           PlaceholderText="{Binding $parent[ItemsControl].((vm:SongEditorViewModel)DataContext).LinesPlaceholder}" />
                  <Button Grid.Column="1" Grid.RowSpan="2" Classes="quiet removeItem" Content="✕" ToolTip.Tip="Usuń część"
                          VerticalAlignment="Top" Margin="6,0,0,0"
                          Command="{Binding $parent[ItemsControl].((vm:SongEditorViewModel)DataContext).RemovePartCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid ColumnDefinitions="Auto,*" HorizontalAlignment="Left">
          <Button Content="+ Dodaj część" IsVisible="{Binding IsText}" Command="{Binding AddPartCommand}" CommandParameter="{x:Null}" />
          <Button Content="+ Dodaj część" IsVisible="{Binding IsSong}">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="Zwrotka" Command="{Binding AddPartCommand}" CommandParameter="V" />
                <MenuItem Header="Refren" Command="{Binding AddPartCommand}" CommandParameter="C" />
                <MenuItem Header="Przedrefren" Command="{Binding AddPartCommand}" CommandParameter="PC" />
                <MenuItem Header="Mostek" Command="{Binding AddPartCommand}" CommandParameter="B" />
                <MenuItem Header="Wstęp" Command="{Binding AddPartCommand}" CommandParameter="I" />
                <MenuItem Header="Interludium" Command="{Binding AddPartCommand}" CommandParameter="INT" />
                <MenuItem Header="Refren końcowy" Command="{Binding AddPartCommand}" CommandParameter="FC" />
                <MenuItem Header="Tag" Command="{Binding AddPartCommand}" CommandParameter="T" />
                <MenuItem Header="Zakończenie" Command="{Binding AddPartCommand}" CommandParameter="E" />
                <MenuItem Header="Inne" Command="{Binding AddPartCommand}" CommandParameter="O" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>

  <UserControl.Styles>
    <Style Selector="TextBox.lyrics">
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="Border.confirm">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style Selector="Button.dangerText">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
  </UserControl.Styles>
</UserControl>
