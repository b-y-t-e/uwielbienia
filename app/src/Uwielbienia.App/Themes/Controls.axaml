<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Background" Value="{DynamicResource InkBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <!-- Typografia: skala 13 / 15 / 18 / 24 -->
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="TextBlock.heading">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.songTitle">
    <Setter Property="FontFamily" Value="{StaticResource TitleFont}" />
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="TextBlock.number">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="TextBlock.chords">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource ChordBrush}" />
  </Style>
  <Style Selector="TextBlock.bodyStrong">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.bodyMuted">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="TextBlock.lead">
    <Setter Property="FontSize" Value="18" />
  </Style>
  <Style Selector="TextBlock.displayNumber">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="TextBlock.overline">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <!-- Panele: jedna płaszczyzna, bez cieni; hierarchię daje kolor tła. -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <!-- Granica między strefami: przezroczysta szczelina, uchwyt widoczny dopiero przy wskazaniu. -->
  <Style Selector="GridSplitter.paneDivider">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Cursor" Value="SizeWestEast" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}">
          <Border Name="PART_Grip" Width="4" Height="36" CornerRadius="2"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Background="{DynamicResource HairlineBrush}" Opacity="0.6" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="GridSplitter.paneDivider:pointerover /template/ Border#PART_Grip">
    <Setter Property="Background" Value="{DynamicResource CandleBrush}" />
    <Setter Property="Height" Value="72" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource CandleBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnCandleBrush}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CandleBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnCandleBrush}" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="Button.quiet">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="8,6" />
  </Style>
  <Style Selector="Button.big">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="Padding" Value="6,12" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="FontSize" Value="15" />
  </Style>
  <Style Selector="ToggleButton">
    <Setter Property="FontSize" Value="15" />
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="FontSize" Value="15" />
  </Style>
  <Style Selector="RadioButton">
    <Setter Property="FontSize" Value="15" />
  </Style>

  <Style Selector="ToggleButton.chip">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CandleSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <Style Selector="TextBox.search">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>

  <!-- Wiersze list (plan, wyniki): całe wiersze klikalne, zaznaczenie tłem. -->
  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0,1" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
  </Style>
  <Style Selector="ListBoxItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
</Styles>
