<Project>
  <!-- VLC (filmy) w wydaniu Windows: tylko 64-bitowy, bez części do nagrywania, transmisji i skryptów.
       Linux używa VLC zainstalowanego w systemie. Wspólne dla programu i narzędzia zrzutów (ten sam zestaw wtyczek). -->
  <PropertyGroup>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsX64Enabled Condition="'$(RuntimeIdentifier)' != '' AND !$(RuntimeIdentifier.StartsWith('win'))">false</VlcWindowsX64Enabled>
  </PropertyGroup>
  <ItemGroup>
    <VlcWindowsX64ExcludeFiles Include="lua\%2A%2A;plugins\lua\%2A%2A;plugins\access_output\%2A%2A;plugins\stream_out\%2A%2A;plugins\mux\%2A%2A;plugins\services_discovery\%2A%2A;plugins\visualization\%2A%2A;plugins\video_splitter\%2A%2A;plugins\keystore\%2A%2A" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />
  </ItemGroup>
</Project>
